#!/usr/bin/env bash
# ==============================================================================
# ⚡ VOID CLI - Unified Command-Line Interface for Void Edge Agent Platform
# ==============================================================================

set -e

# Resolve repository directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/app.py" ]; then
    VOID_DIR="$SCRIPT_DIR"
elif [ -f "$SCRIPT_DIR/../app.py" ]; then
    VOID_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
elif [ -d "$HOME/void" ]; then
    VOID_DIR="$HOME/void"
else
    VOID_DIR="$(pwd)"
fi

# Locate Python Virtual Environment
if [ -f "$VOID_DIR/.venv/bin/python3" ]; then
    PYTHON_BIN="$VOID_DIR/.venv/bin/python3"
elif [ -f "$HOME/.void-venv/bin/python3" ]; then
    PYTHON_BIN="$HOME/.void-venv/bin/python3"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python3)"
else
    echo "[ERROR] Python 3 not found. Please run install.sh first."
    exit 1
fi

PID_FILE="$HOME/.void.pid"

# Colors
C_CYAN='\033[0;36m'
C_GREEN='\033[0;32m'
C_YELLOW='\033[1;33m'
C_RED='\033[0;31m'
C_RESET='\033[0m'
C_BOLD='\033[1m'

show_banner() {
    echo -e "${C_CYAN}${C_BOLD}"
    echo "  ██╗   ██╗ ██████╗ ██╗██████╗ "
    echo "  ██║   ██║██╔═══██╗██║██╔══██╗"
    echo "  ██║   ██║██║   ██║██║██║  ██║"
    echo "  ╚██╗ ██╔╝██║   ██║██║██║  ██║"
    echo "   ╚████╔╝ ╚██████╔╝██║██████╔╝"
    echo "    ╚═══╝   ╚═════╝ ╚═╝╚═════╝ "
    echo -e "  Autonomous Edge Agent Platform (Terminal & Telegram Native)${C_RESET}"
    echo ""
}

show_help() {
    show_banner
    echo -e "${C_BOLD}Usage:${C_RESET} void <command> [options]"
    echo ""
    echo -e "${C_BOLD}Commands:${C_RESET}"
    echo -e "  ${C_CYAN}cli${C_RESET}                Launch interactive ReAct TUI session (default)"
    echo -e "  ${C_CYAN}fastfetch${C_RESET}          Display visual ASCII/Unicode system & edge telemetry"
    echo -e "  ${C_CYAN}setup-bot${C_RESET}          Run interactive Telegram bot wizard with Admin ID auto-detection"
    echo -e "  ${C_CYAN}setup-model${C_RESET}        Run interactive local LLM setup wizard with RAM detection"
    echo -e "  ${C_CYAN}vault${C_RESET}              Manage Telegram group cloud memory & media vault"
    echo -e "  ${C_CYAN}plugins${C_RESET}            Manage dynamic extensions (list, search, install, remove)"
    echo -e "  ${C_CYAN}models${C_RESET}             List installed local small-model weights & catalog"
    echo -e "  ${C_CYAN}start${C_RESET}              Start background daemons & Telegram bot (foreground)"
    echo -e "  ${C_CYAN}start-bg${C_RESET}           Start Void as a background service (24/7 daemon)"
    echo -e "  ${C_CYAN}stop${C_RESET}               Stop running background Void service"
    echo -e "  ${C_CYAN}status${C_RESET}             Check running status, memory RSS, and telemetry"
    echo -e "  ${C_CYAN}test${C_RESET}               Run automated test suite (pytest)"
    echo -e "  ${C_CYAN}clean${C_RESET}              Run system and temporary storage cleaner"
    echo -e "  ${C_CYAN}permissions${C_RESET}        Inspect Android permissions status & privacy policy"
    echo -e "  ${C_CYAN}update${C_RESET}             Pull latest updates and sync dependencies"
    echo -e "  ${C_CYAN}help${C_RESET}               Show this help message"
    echo ""
    echo -e "${C_BOLD}Options (for start / start-bg):${C_RESET}"
    echo -e "  ${C_CYAN}--telegram <token>${C_RESET} Telegram bot API token"
    echo -e "  ${C_CYAN}--admin-id <id>${C_RESET}    Whitelisted Admin Telegram User ID"
    echo -e "  ${C_CYAN}--no-wake-lock${C_RESET}     Disable CPU wake-lock (suppresses notification sound)"
    echo -e "  ${C_CYAN}--no-daemons${C_RESET}       Disable background proactive daemons"
    echo -e "  ${C_CYAN}--vault-pass <key>${C_RESET} Passphrase for encrypted credential vault"
    echo ""
}

cmd_cli() {
    cd "$VOID_DIR"
    exec "$PYTHON_BIN" "$VOID_DIR/termux_void.py" "$@"
}

cmd_fastfetch() {
    cd "$VOID_DIR"
    "$PYTHON_BIN" -c "from core.fastfetch import FastFetchCollector; print(FastFetchCollector().render_ascii())"
}

cmd_setup_bot() {
    cd "$VOID_DIR"
    exec "$PYTHON_BIN" "$VOID_DIR/core/bot_setup.py"
}

cmd_plugins() {
    cd "$VOID_DIR"
    ACTION="${1:-list}"
    shift || true
    "$PYTHON_BIN" -c "
import sys
from extensions.manager import global_extension_manager

action = '$ACTION'
args = sys.argv[1:]

if action == 'list':
    loaded = global_extension_manager.list_extensions()
    print('=' * 60)
    print(' 🧩 ACTIVE PLUGINS (' + str(len(loaded)) + ')')
    print('=' * 60)
    if not loaded:
        print('  Zero extensions loaded. System running in hyper-lean mode.')
        print('  Use \"void plugins search\" to explore community extensions.')
    for p in loaded:
        print(f' • {p[\"name\"]} v{p[\"version\"]} - {p[\"description\"]}')
        print(f'   Tools: {p.get(\"tools\", [])}')
    print('=' * 60)

elif action in ('search', 'find'):
    q = ' '.join(args)
    results = global_extension_manager.search_catalog(q)
    print('=' * 60)
    print(' 🔍 COMMUNITY PLUGINS CATALOG (' + str(len(results)) + ' matches)')
    print('=' * 60)
    for r in results:
        stat = '✅ INSTALLED' if r['installed'] else '📥 AVAILABLE'
        print(f' • {r[\"id\"]:<16} [{stat}] v{r[\"version\"]}')
        print(f'   {r[\"description\"]}')
        print(f'   Tools: {r[\"tools\"]}')
    print('=' * 60)
    print('To install: void plugin install <plugin_id>')

elif action in ('install', 'add'):
    if not args:
        print('Usage: void plugin install <plugin_id>')
        sys.exit(1)
    pid = args[0]
    print(f'Downloading & verifying plugin \"{pid}\"...')
    res = global_extension_manager.install_plugin(pid)
    if res.get('success'):
        print('✅ ' + res['message'])
    else:
        print('❌ Install failed: ' + str(res.get('error')))

elif action in ('remove', 'uninstall', 'delete'):
    if not args:
        print('Usage: void plugin remove <plugin_id>')
        sys.exit(1)
    pid = args[0]
    res = global_extension_manager.uninstall_plugin(pid)
    print('✅ ' + res['message'])
else:
    print('Unknown plugins action: ' + action + '. Try list, search, install, or remove.')
" "$@"
}

cmd_models() {
    cd "$VOID_DIR"
    "$PYTHON_BIN" -c "
from core.model_manager import global_model_manager
installed = global_model_manager.list_installed_models()
available = global_model_manager.list_available_models()
active = global_model_manager.get_active_model_name()
print('=' * 60)
print(' 🧠 VOID LOCAL EDGE MODELS')
print('=' * 60)
print(f' Active Engine: {active or \"Deterministic ReAct (Zero-Weight Heuristic)\"}')
print(f' Models Dir:    {global_model_manager.models_dir}')
print('-' * 60)
print('Catalog:')
for mid, m in available.items():
    status = '✅ INSTALLED' if m['installed'] else '📥 AVAILABLE'
    print(f' • {mid:<14} {m[\"name\"]} ({m[\"size_mb\"]}MB) [{status}]')
    print(f'   {m[\"description\"]}')
print('=' * 60)
"
}

cmd_setup_model() {
    cd "$VOID_DIR"
    exec "$PYTHON_BIN" -c "from core.model_manager import global_model_manager; global_model_manager.run_interactive_wizard()"
}

cmd_vault() {
    cd "$VOID_DIR"
    "$PYTHON_BIN" -c "
import sys
from telegram.services.cloud_vault import global_cloud_vault
args = sys.argv[1:]
if not args or args[0] in ('status', 'info'):
    info = global_cloud_vault.get_vault_telemetry()
    print('=' * 60)
    print(' ☁️ VOID TELEGRAM CLOUD STORAGE VAULT')
    print('=' * 60)
    print(f' Configured:  {info.get(\"configured\")}')
    print(f' Group Title: {info.get(\"group_title\")}')
    print(f' Group ID:    {info.get(\"group_id\")}')
    print(f' Total Files: {info.get(\"total_files\", 0)}')
    print(f' Stored Size: {round(info.get(\"bytes_stored\", 0)/(1024*1024), 2)} MB')
    print(f' Last Upload: {info.get(\"last_upload_iso\")}')
    print('=' * 60)
elif args[0] in ('backup', 'sync'):
    print('[INFO] Backing up memory snapshot to vault...')
    res = global_cloud_vault.upload_memory_snapshot()
    if res.get('success'):
        print(f'✅ Vault backup uploaded! Message #{res.get(\"telegram_message_id\")}')
    else:
        print(f'❌ Backup failed: {res.get(\"error\")}')
elif args[0] in ('files', 'list'):
    records = global_cloud_vault.query_vault(limit=10)
    print('Stored Vault Records:')
    for r in records:
        print(f' • #{r.id} {r.file_name} ({round(r.file_size/1024, 1)} KB) [{r.category}] Msg #{r.telegram_message_id}')
elif args[0] == 'set' and len(args) > 1:
    cid = int(args[1])
    global_cloud_vault.set_vault_group_id(cid, group_title='Configured via CLI')
    print(f'✅ Vault group ID set to {cid}')
else:
    print('Usage: void vault [status|backup|files|set <group_id>]')
" "$@"
}

cmd_start() {
    cd "$VOID_DIR"

    if [ -f "$PID_FILE" ]; then
        OLD_PID=$(cat "$PID_FILE" 2>/dev/null || true)
        if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
            echo -e "${C_YELLOW}[INFO]${C_RESET} Stopping active background Void instance (PID: $OLD_PID)..."
            kill -15 "$OLD_PID" 2>/dev/null || kill -9 "$OLD_PID" 2>/dev/null
            rm -f "$PID_FILE"
            sleep 1
        fi
        rm -f "$PID_FILE"
    fi

    echo -e "${C_GREEN}[INFO]${C_RESET} Starting Void Autonomous Edge Stack..."
    exec "$PYTHON_BIN" "$VOID_DIR/app.py" "$@"
}

cmd_start_bg() {
    cd "$VOID_DIR"
    if [ -f "$PID_FILE" ]; then
        OLD_PID=$(cat "$PID_FILE" 2>/dev/null || true)
        if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
            echo -e "${C_YELLOW}[INFO]${C_RESET} Void background service is already active with PID $OLD_PID."
            echo -e "  • FastFetch:     ${C_CYAN}void fastfetch${C_RESET}"
            echo -e "  • Log stream:    ${C_CYAN}tail -f $HOME/.void.log${C_RESET}"
            echo -e "  • To restart:    ${C_CYAN}void stop && void start-bg${C_RESET}"
            exit 0
        fi
        rm -f "$PID_FILE"
    fi

    ROGUE_PIDS=$(pgrep -f "python.*app.py" || true)
    if [ -n "$ROGUE_PIDS" ]; then
        echo -e "${C_YELLOW}[INFO]${C_RESET} Stopping stale Void process ($ROGUE_PIDS)..."
        kill -15 $ROGUE_PIDS 2>/dev/null || true
        sleep 1
        kill -9 $ROGUE_PIDS 2>/dev/null || true
        sleep 0.5
    fi

    echo -e "${C_GREEN}[INFO]${C_RESET} Launching Void in background..."
    nohup "$PYTHON_BIN" "$VOID_DIR/app.py" "$@" > "$HOME/.void.log" 2>&1 &
    NEW_PID=$!
    echo "$NEW_PID" > "$PID_FILE"
    sleep 1

    if kill -0 "$NEW_PID" 2>/dev/null; then
        echo -e "${C_GREEN}[SUCCESS]${C_RESET} Void started successfully (PID: $NEW_PID)."
        echo -e "  • FastFetch:     ${C_CYAN}void fastfetch${C_RESET}"
        echo -e "  • Log File:      ${C_CYAN}$HOME/.void.log${C_RESET}"
    else
        echo -e "${C_RED}[ERROR]${C_RESET} Void failed to start. Inspect $HOME/.void.log for details."
        exit 1
    fi
}

cmd_stop() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE" 2>/dev/null || true)
        if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
            echo -e "${C_YELLOW}[INFO]${C_RESET} Terminating Void process (PID: $PID)..."
            kill -15 "$PID" 2>/dev/null || kill -9 "$PID" 2>/dev/null
            rm -f "$PID_FILE"
            echo -e "${C_GREEN}[SUCCESS]${C_RESET} Void service halted."
            exit 0
        fi
        rm -f "$PID_FILE"
    fi

    ROGUE_PIDS=$(pgrep -f "python.*app.py" || true)
    if [ -n "$ROGUE_PIDS" ]; then
        echo -e "${C_YELLOW}[INFO]${C_RESET} Halting active Void processes: $ROGUE_PIDS"
        kill -15 $ROGUE_PIDS 2>/dev/null || kill -9 $ROGUE_PIDS 2>/dev/null
        echo -e "${C_GREEN}[SUCCESS]${C_RESET} Stopped."
    else
        echo -e "${C_CYAN}[INFO]${C_RESET} No running Void instances found."
    fi
}

cmd_status() {
    show_banner
    RUNNING=0
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if kill -0 "$PID" 2>/dev/null; then
            RUNNING=1
            echo -e "● Status:        ${C_GREEN}ACTIVE (Running, PID: $PID)${C_RESET}"
            if command -v ps >/dev/null 2>&1; then
                RSS_KB=$(ps -p "$PID" -o rss= 2>/dev/null | tr -d ' ' || echo "0")
                if [ -n "$RSS_KB" ] && [ "$RSS_KB" -gt 0 ] 2>/dev/null; then
                    RSS_MB=$(awk "BEGIN {printf \"%.2f\", $RSS_KB/1024}")
                    echo -e "● Memory RSS:    ${C_CYAN}${RSS_MB} MB${C_RESET} (Target: < 30MB)"
                fi
            fi
        fi
    fi

    if [ "$RUNNING" -eq 0 ]; then
        echo -e "● Status:        ${C_RED}INACTIVE (Stopped)${C_RESET}"
    fi

    echo ""
    cmd_fastfetch
}

cmd_test() {
    cd "$VOID_DIR"
    echo -e "${C_CYAN}[INFO]${C_RESET} Running Void test suite..."
    exec "$PYTHON_BIN" -m pytest -v "$@"
}

cmd_clean() {
    cd "$VOID_DIR"
    echo -e "${C_CYAN}[INFO]${C_RESET} Executing Void Storage Cleaner..."
    "$PYTHON_BIN" -c "from tools.system import CleanStorageStrategy; print(CleanStorageStrategy().run_safe(dry_run=False).output['summary'])"
}

cmd_permissions() {
    cd "$VOID_DIR"
    "$PYTHON_BIN" -c "from security.permissions import PermissionManager; print(PermissionManager.generate_cli_report())"
}

cmd_update() {
    cd "$VOID_DIR"
    echo -e "${C_CYAN}[INFO]${C_RESET} Pulling latest code from GitHub..."
    git pull origin main
    echo -e "${C_CYAN}[INFO]${C_RESET} Syncing Python dependencies..."
    "$PYTHON_BIN" -m pip install -r requirements.txt
    echo -e "${C_GREEN}[SUCCESS]${C_RESET} Void is up to date!"
}

# Subcommand dispatch
SUBCMD="${1:-cli}"
shift || true

case "$SUBCMD" in
    cli)
        cmd_cli "$@"
        ;;
    fastfetch|fetch)
        cmd_fastfetch "$@"
        ;;
    setup-bot|setup|bot-setup)
        cmd_setup_bot "$@"
        ;;
    setup-model|model-setup|wizard)
        cmd_setup_model "$@"
        ;;
    vault|cloud-vault)
        cmd_vault "$@"
        ;;
    plugins|plugin)
        cmd_plugins "$@"
        ;;
    models|model)
        cmd_models "$@"
        ;;
    start)
        cmd_start "$@"
        ;;
    start-bg)
        cmd_start_bg "$@"
        ;;
    stop)
        cmd_stop "$@"
        ;;
    status)
        cmd_status "$@"
        ;;
    test)
        cmd_test "$@"
        ;;
    clean)
        cmd_clean "$@"
        ;;
    permissions|perm)
        cmd_permissions "$@"
        ;;
    update)
        cmd_update "$@"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo -e "${C_RED}[ERROR]${C_RESET} Unknown command: '$SUBCMD'"
        show_help
        exit 1
        ;;
esac
